{
  "outputDirectory": "dist/web",
  "regions": ["icn1"],
  "functions": {
    "api/recommend.ts": {
      "maxDuration": 60
    },
    "api/session-create.ts": {
      "maxDuration": 10
    },
    "api/session-join.ts": {
      "maxDuration": 10
    },
    "api/session-get.ts": {
      "maxDuration": 10
    },
    "api/admin-batch.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin-batch",
      "schedule": "0 18 * * *"
    }
  ]
}
